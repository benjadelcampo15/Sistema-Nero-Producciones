# Copiá este archivo como .env.local y completá los valores.
# .env.local NO se sube a git.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Clave secreta: saltea toda la seguridad de la base. Nunca la compartas ni la pongas en el navegador.
SUPABASE_SECRET_KEY=sb_secret_...

# IA para leer facturas. AI_MODEL: ver npm run ia:modelos
# CUIT de Nero (ayuda a la IA a saber si la factura es emitida o recibida)
NERO_CUIT=

# AI_PROVIDER=gemini   (desarrollo, solo facturas de prueba)  |  openai (producción)
AI_PROVIDER=gemini
# Varios modelos separados por coma: si uno está saturado se usa el siguiente.
AI_MODEL=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest
GEMINI_API_KEY=
OPENAI_API_KEY=

# ARCA (factura electrónica). Entorno: homologacion (pruebas) | produccion
ARCA_ENTORNO=homologacion
ARCA_CUIT=
# Local: rutas a los archivos (carpeta .arca/, ignorada por git).
ARCA_CERT_PATH=.arca/homologacion.crt
ARCA_KEY_PATH=.arca/homologacion.key
# En el hosting: el contenido PEM completo (con saltos de línea como \n).
# ARCA_CERT=
# ARCA_KEY=
